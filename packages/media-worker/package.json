{
  "name": "@repo/media-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/worker.ts",
    "process:once": "MEDIA_WORKER_ONCE=1 node --experimental-strip-types src/worker.ts",
    "docker:build": "docker build -f Dockerfile -t travel-media-worker ../..",
    "docker:run": "docker run --env-file .env.local --restart unless-stopped --memory=512m --cpus=1 travel-media-worker",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@supabase/supabase-js": "2.116.0",
    "pdfjs-dist": "5.4.149",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  }
}

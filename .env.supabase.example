# Shared by web/admin for dev:supabase, build:supabase, start:supabase and test:supabase.
# Copy to .env.supabase.local (gitignored). Use literal values, not $VARIABLE expansion.
# One remote Supabase project serves local live mode, Preview, and Production.
# Set the travel-blog URL from supabase/deployment.json. dev:supabase can write
# real data; use dev:mock or a disposable local stack for destructive testing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional shared settings; app-specific overrides: apps/<app>/.env.supabase.local.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Turn on only after the SQL migration, Edge Function, and role tests pass.
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_APP_RELEASE=local
# Server-only: use a new random key shared with the Supabase Edge secret.
# TRAVEL_ERROR_REPORT_KEY=
# Supabase Edge secret (never in a public Vercel variable): list exact web/admin
# Production, fixed Preview, and localhost origins before deploying strict CORS.
# TRAVEL_API_ALLOWED_ORIGINS=https://blog.example.com,https://admin.example.com,https://preview-blog.example.com,https://preview-admin.example.com,http://localhost:3000,http://localhost:3002

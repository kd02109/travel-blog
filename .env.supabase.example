# Shared by web/admin for dev:supabase, build:supabase, start:supabase and test:supabase.
# Copy to .env.supabase.local (gitignored). Use literal values, not $VARIABLE expansion.
# Set this from supabase/deployment.json, or enter the URL of another dev project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional shared settings; app-specific overrides: apps/<app>/.env.supabase.local.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Turn on only after the SQL migration, Edge Function, and role tests pass.
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_APP_RELEASE=local
# Server-only: use a new random key shared with the Supabase Edge secret.
# TRAVEL_ERROR_REPORT_KEY=
# Supabase Edge secret (set per project, not in a public Vercel variable):
# TRAVEL_API_ALLOWED_ORIGINS=https://blog.example.com,https://admin.example.com
# Include localhost web/admin origins only in the isolated staging project.

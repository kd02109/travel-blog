# Media worker only. Copy these to the admin Vercel project's server-only
# Preview/Production environment, using separate Supabase projects and keys.
# For local admin-only testing, use apps/admin/.env.supabase.local (gitignored).
# Never add NEXT_PUBLIC_ to any of these names.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
TRAVEL_MEDIA_WORKER_ENABLED=false

# Media worker only. Set these server-only variables in the admin Vercel
# project. Preview and Production use the same travel-blog Supabase project;
# match the service key to SUPABASE_URL. For local admin-only testing, use
# apps/admin/.env.supabase.local (gitignored).
# Never add NEXT_PUBLIC_ to any of these names.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
TRAVEL_MEDIA_WORKER_ENABLED=false
# Preview calls process the real shared queue when this is true. Keep disabled
# except for an explicitly planned, monitored test; never poll with Docker too.
# Build-time opt-in; enable only on an approved production deployment with a
# plan that supports one-minute Cron. Changing this requires a new deployment.
TRAVEL_MEDIA_CRON_ENABLED=false

# Server-only error email dispatcher. No NEXT_PUBLIC_ prefix.
# Resend onboarding sender works only for your Resend account email in preview/dev.
RESEND_API_KEY=
ERROR_EMAIL_FROM=onboarding@resend.dev
ERROR_EMAIL_TO=
ERROR_EMAIL_ENVIRONMENT=preview
ERROR_EMAIL_SITE_SLUG=parents-travel
TRAVEL_ERROR_EMAIL_ENABLED=false
# Uses CRON_SECRET and SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above.
# Production requires a verified sender domain. Scheduling is opt-in; see README.

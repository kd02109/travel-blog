# For real Supabase credentials, use root/app .env.supabase.local.
# Copy to .env.local. Empty integrations stay disabled; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# CI-only source map upload credentials
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Managed by dev:mock / dev:supabase; do not use this flag to switch modes.
NEXT_PUBLIC_API_MOCKING=disabled
